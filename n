forecast_rows = []

for (tech, spec), grp in weekly_cr_seg.groupby(['technology', 'specialisation']):
    # Skip segments not in the model
    if not any((all_seg_cr[tech_cols_cr + spec_cols_cr] == 
                pd.get_dummies(pd.Series([tech]), prefix='technology')
                .reindex(columns=tech_cols_cr, fill_value=0).iloc[0].to_dict()).all(axis=1)):
        continue

    history = list(grp['cr_count'].values)
    
    # Get segment one-hot flags from all_seg_cr
    seg_mask = (
        all_seg_cr[tech_cols_cr].idxmax(axis=1).str.replace('technology_', '') == tech
    ) & (
        all_seg_cr[spec_cols_cr].idxmax(axis=1).str.replace('specialisation_', '') == spec
    )
    seg_flags = all_seg_cr[seg_mask][tech_cols_cr + spec_cols_cr].iloc[0].to_dict()
    
    week_forecasts = []
    for i, date in enumerate(forecast_dates):
        hist = pd.Series(history)
        row = {}
        roll_4 = hist.iloc[-4:].mean() if len(hist) >= 4 else hist.mean()
        roll_8 = hist.iloc[-8:].mean() if len(hist) >= 8 else hist.mean()
        std_8  = hist.iloc[-8:].std()  if len(hist) >= 8 else 0

        row['lag_1']       = hist.iloc[-1]
        row['roll_4w']     = roll_4
        row['above_avg']   = int(hist.iloc[-1] > roll_4)
        row['is_spike']    = int(hist.iloc[-1] > roll_8 + 1.5 * std_8)
        row['is_dip']      = int(hist.iloc[-1] < roll_8 - 1.5 * std_8)
        row['month']       = date.month
        row['trend']       = len(all_seg_cr) + i
        row['level_shift'] = int(date >= pd.Timestamp('2026-03-01'))
        row.update(seg_flags)

        row_df = pd.DataFrame([row])[FEATURES_SEG_CR]
        pred = max(0, round(best_cr_seg_model.predict(row_df)[0]))
        week_forecasts.append(pred)
        history.append(pred)

    forecast_rows.append({
        'technology':     tech,
        'specialisation': spec,
        **{f'week_{i+1}': v for i, v in enumerate(week_forecasts)},
        'pxn_date': pxn_date
    })

forecast_df = pd.DataFrame(forecast_rows).sort_values(['technology', 'specialisation'])
print(forecast_df.to_string(index=False))
